#!/bin/bash

CMD_XDEBUG_OFF="XDEBUG_MODE=off"
CMD_VITE_FIX="jq --arg v 'vite --host 0.0.0.0' '.scripts.dev = \$v' package.json > tmp.json && mv -f tmp.json package.json"
CMD_COMPOSER_PHP_VER="jq --arg v '^8.4' '.require.php = \$v' composer.json > tmp.json && mv -f tmp.json composer.json"


function cmd_up() {
    if [ ! -f .env ]; then
        cp '_dev/.env.example.development' '.env'
    fi

    local in_container
    in_container=$1
    shift

    if [ "$in_container" = true ]; then
       echo "Cannot run 'up' command from inside the container"
       exit 1
    fi

    local build=""
    if [ "$1" == "-b" ]; then
        build="--build"
    fi

    docker compose up -d $build

    if [ "$1" == "-b" ]; then
        if [ -f ./composer.json ]; then
            docker compose exec app bash -c "$CMD_XDEBUG_OFF && composer install"
        fi
        if [ -f ./package.json ]; then
            docker compose exec app bash -c "sudo mkdir -p /var/www/.npm && sudo chown -R 1000:33 /var/www/.npm"
            docker compose exec app bash -c "npm install"
        fi
    fi
}

function cmd_down() {
    local in_container
    in_container=$1
    shift

    if [ "$in_container" = true ]; then
       echo "Cannot run 'up' command from inside the container"
       exit 1
    fi

    docker compose down $1
}

function cmd_install() {
    if [ ! -f .env ]; then
        cp '_dev/.env.example.development' '.env'
    fi

    local in_container
    in_container=$1
    shift

    local package_name
    local package_version_number
    package_name=$(echo "$1" | cut -d':' -f1)
    package_version_number=$(echo "$1" | cut -d':' -f2)

    if [[ -z "$package_name" || -z "$package_version_number" ]]; then
        echo "Invalid format. Expected 'package_name:version'."
        return 1
    fi

    if [ "$package_name" == "laravel" ]; then
        local commands
        commands="
            $CMD_XDEBUG_OFF && \
            chmod +x ./_dev/env_updater && \
            composer create-project --prefer-dist laravel/laravel:^$package_version_number.0 laravel-dev && \
            ./_dev/env_updater && \
            shopt -s dotglob && \
            mv ./laravel-dev/* . && \
            rm -rf ./laravel-dev && \
            $CMD_VITE_FIX && \
            $CMD_COMPOSER_PHP_VER && \
            composer require predis/predis && \
            composer install && \
            sudo mkdir -p /var/www/.npm && \
            sudo chown -R www-data:www-data /var/www/.npm && \
            npm install && \
            git add ."

        if [ "$in_container" = true ]; then
            bash -c "$commands"
        else
            docker compose build
            docker compose up -d
            docker compose exec app bash -c "$commands"
        fi
    else
        echo "Invalid package name. Expected 'laravel:version'."
        return 1
    fi
}

function cmd_run() {
    local in_container
    in_container=$1
    shift

    local commands

    case $1 in
        build)
            commands="npm run build"
            ;;
        dev)
            commands="$CMD_XDEBUG_OFF && \
                      $CMD_VITE_FIX && \
                      composer run dev"
            ;;
    esac

    if [ "$in_container" = true ]; then
        bash -c "$commands"
    else
        docker compose exec app bash -c "$commands"
    fi
}

function cmd_other_commands() {
    local in_container
    in_container=$1
    shift

    local commands

    case $1 in
        artisan) app="php artisan" ;;
        *) app=$1 ;;
    esac

    shift

    local commands
    commands="$CMD_XDEBUG_OFF && $app $*"

    if [ "$in_container" = true ]; then
        bash -c "$commands"
    else
        docker compose exec app bash -c "$commands"
    fi
}
