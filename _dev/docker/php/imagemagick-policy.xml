<?xml version="1.0" encoding="UTF-8"?>
<policymap>
    <policy domain="resource" name="memory" value="128MiB"/>
    <policy domain="resource" name="map" value="256MiB"/>
    <policy domain="resource" name="disk" value="512MiB"/>
    <!-- Area is a pixel-cache threshold, not a rejection limit. Enforce max_pixels in the application. -->
    <policy domain="resource" name="area" value="16MP"/>
    <policy domain="resource" name="width" value="12000"/>
    <policy domain="resource" name="height" value="12000"/>
    <!-- ImageMagick 6 uses an exclusive bound here; 2 allows a single frame. -->
    <policy domain="resource" name="list-length" value="2"/>
    <policy domain="resource" name="thread" value="1"/>
    <!-- IM6's time limit includes idle time across requests/jobs. Use FPM and per-job timeouts instead. -->
    <policy domain="delegate" rights="none" pattern="*"/>
    <policy domain="filter" rights="none" pattern="*"/>
    <policy domain="path" rights="none" pattern="@*"/>
    <policy domain="coder" rights="none" pattern="*"/>
    <policy domain="coder" rights="read|write" pattern="{JPEG,PNG,WEBP}"/>
</policymap>
