APP_NAME="Laravel project"
APP_TIMEZONE=UTC
APP_DEBUG=true
APP_URL=http://localhost

REVERB_APP_ID=laravel-project-local
REVERB_APP_KEY=laravel-project-local
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_SCALING_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http
MESSAGING_BROADCASTING_ENABLED=false
PARTNERSHIP_REQUEST_URL=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=laravel_project_cache

COMPOSE_PROJECT_NAME=laravelproject
COMPOSE_FILE=_dev/docker-compose.yml

# Match the production PHP 8.4 runtime.
PHP_VERSION=8.4

PHP_IDE_CONFIG="serverName=laravel_project_server_mapping"

XDEBUG_VERSION=3.4.1
XDEBUG_MODE=debug
XDEBUG_CLIENT_HOST=dockerhost
XDEBUG_CLIENT_PORT=9003
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_DISCOVER_CLIENT_HOST=on

EXT_DB_PORT=10000
EXT_REDIS_PORT=10001
EXT_WEB_PORT=3000
EXT_VITE_PORT1=5173
EXT_VITE_PORT2=8000
