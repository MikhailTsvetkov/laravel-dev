APP_NAME=Laravel
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=cabal_api_cache

COMPOSE_PROJECT_NAME=laravel
COMPOSE_FILE=_dev/docker-compose.yml

PHP_IDE_CONFIG=serverName=laravel_server_mapping

XDEBUG_MODE=debug
XDEBUG_CLIENT_HOST=dockerhost
XDEBUG_CLIENT_PORT=9003
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_DISCOVER_CLIENT_HOST=on

EXT_DB_PORT=10000
EXT_REDIS_PORT=10001
